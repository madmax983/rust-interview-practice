//! # Tar Archive Implementation
//!
//! Implements a basic USTAR (Unix Standard TAR) archive reader and writer.
//!
//! **Replaces Crates:** `tar`
//!
//! **Real-world Usage:**
//! - Container images (Docker/OCI layers are often tarballs)
//! - Archiving multiple files into a single stream
//! - Backup systems
//!
//! **Why build it yourself?**
//! It teaches you about 512-byte block alignment, fixed-size C-style string fields
//! padded with nulls, and encoding integers/sizes as ASCII octal strings. It exposes
//! how seemingly complex file formats are often just concatenated headers and data blocks.
//!
//! # Architecture
//!
//! A tar file is a sequence of 512-byte blocks.
//! Each file in the archive consists of:
//! 1. A 512-byte header block (metadata: name, mode, size, checksum).
//! 2. N 512-byte blocks of file data (padded with zeros).
//! 3. The archive ends with two consecutive 512-byte blocks of zeros.
//!
//! **Invariants:**
//! 1. All headers and data sections must align to 512-byte boundaries.
//! 2. Numeric fields (mode, size, mtime, checksum) are encoded as ASCII octal, terminated by a space or null.
//! 3. The checksum is calculated assuming the checksum field itself is filled with spaces (ASCII 32).
//!
//! **Complexity:**
//! - Read/Write: O(N) where N is the total size of files to archive.
//!
//! **Tradeoffs:**
//! - We load the entire file content into memory (`Vec<u8>`). A production implementation would stream data directly from `Read`/`Write` traits.
//!
//! # Comparison to Canonical Crates
//! - `tar`: The standard Rust tar implementation. It supports streaming read/write, GNU extensions (for long filenames/large files), and PAX headers.
//!
//! **Missing vs Production:**
//! - Streaming APIs (we use `Vec<u8>` for simplicity).
//! - GNU/PAX extensions (we only support standard 100-character filenames and 8GB size limit of USTAR).
//! - Directory entries (we only implement regular files).

use std::io::{self, Read, Write};

const BLOCK_SIZE: usize = 512;

/// Formats a `u64` into an octal ASCII string padded with zeros, terminated with a null byte.
fn format_octal(value: u64, width: usize) -> Vec<u8> {
    let mut s = format!("{:0>width$o}", value, width = width - 1);
    s.push('\0');
    s.into_bytes()
}

/// Parses an octal ASCII string into a `u64`.
fn parse_octal(bytes: &[u8]) -> Option<u64> {
    let s = std::str::from_utf8(bytes).ok()?;
    // Trim nulls and spaces
    let s = s.trim_matches(|c| c == '\0' || c == ' ');
    if s.is_empty() {
        return Some(0);
    }
    u64::from_str_radix(s, 8).ok()
}

/// Calculates the USTAR header checksum.
fn calculate_checksum(header: &[u8; BLOCK_SIZE]) -> u64 {
    let mut sum: u64 = 0;
    for (i, &byte) in header.iter().enumerate() {
        if (148..156).contains(&i) {
            // Checksum field itself is treated as spaces
            sum += 32;
        } else {
            sum += u64::from(byte);
        }
    }
    sum
}

/// Represents a single file entry in the Tar archive.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TarEntry {
    pub name: String,
    pub mode: u64,
    pub size: u64,
    pub mtime: u64,
    pub data: Vec<u8>,
}

/// A simple Tar Archive builder/reader.
pub struct TarArchive {
    entries: Vec<TarEntry>,
}

impl TarArchive {
    /// Creates a new, empty Tar archive.
    #[must_use]
    pub fn new() -> Self {
        Self {
            entries: Vec::new(),
        }
    }

    /// Adds a new file to the archive.
    pub fn add_file(&mut self, name: &str, data: &[u8]) {
        self.entries.push(TarEntry {
            name: name.to_string(),
            mode: 0o644, // Default rw-r--r--
            size: data.len() as u64,
            mtime: 0, // Using 0 for simplicity
            data: data.to_vec(),
        });
    }

    /// Serializes the archive into a standard Tar format.
    ///
    /// # Errors
    /// Returns an error if writing to the destination fails.
    pub fn write_to<W: Write>(&self, mut writer: W) -> io::Result<()> {
        for entry in &self.entries {
            let mut header = [0u8; BLOCK_SIZE];

            // name: 100 bytes
            let name_bytes = entry.name.as_bytes();
            let name_len = name_bytes.len().min(100);
            header[0..name_len].copy_from_slice(&name_bytes[..name_len]);

            // mode: 8 bytes
            let mode_bytes = format_octal(entry.mode, 8);
            header[100..108].copy_from_slice(&mode_bytes);

            // uid: 8 bytes (0)
            header[108..116].copy_from_slice(&format_octal(0, 8));

            // gid: 8 bytes (0)
            header[116..124].copy_from_slice(&format_octal(0, 8));

            // size: 12 bytes
            let size_bytes = format_octal(entry.size, 12);
            header[124..136].copy_from_slice(&size_bytes);

            // mtime: 12 bytes
            let mtime_bytes = format_octal(entry.mtime, 12);
            header[136..148].copy_from_slice(&mtime_bytes);

            // typeflag: 1 byte (0 or '0' for regular file)
            header[156] = b'0';

            // magic: 6 bytes ("ustar\0")
            header[257..263].copy_from_slice(b"ustar\0");

            // version: 2 bytes ("00")
            header[263..265].copy_from_slice(b"00");

            // calculate checksum
            let checksum = calculate_checksum(&header);
            // USTAR checksum is 6 digits + null + space
            let mut checksum_str = format!("{:06o}\0 ", checksum).into_bytes();
            if checksum_str.len() > 8 {
                checksum_str.truncate(8);
            }
            header[148..156].copy_from_slice(&checksum_str);

            writer.write_all(&header)?;

            // Write data blocks
            writer.write_all(&entry.data)?;

            // Pad data to BLOCK_SIZE
            let remainder = entry.data.len() % BLOCK_SIZE;
            if remainder > 0 {
                let padding = BLOCK_SIZE - remainder;
                writer.write_all(&vec![0u8; padding])?;
            }
        }

        // Write end of archive (two 512-byte blocks of zeros)
        writer.write_all(&[0u8; BLOCK_SIZE * 2])?;
        Ok(())
    }

    /// Reads a Tar archive from a reader.
    ///
    /// # Errors
    /// Returns an error if reading fails, or if the archive is malformed.
    pub fn read_from<R: Read>(mut reader: R) -> io::Result<Self> {
        let mut archive = Self::new();
        let mut header = [0u8; BLOCK_SIZE];

        loop {
            let bytes_read = reader.read(&mut header)?;
            if bytes_read == 0 {
                break; // EOF
            }
            if bytes_read != BLOCK_SIZE {
                return Err(io::Error::new(
                    io::ErrorKind::UnexpectedEof,
                    "Incomplete header block",
                ));
            }

            // Two blocks of zeros indicates EOF in Tar
            if header.iter().all(|&b| b == 0) {
                // Technically need to read one more block, but we can just stop
                break;
            }

            let name_bytes = &header[0..100];
            let name_end = name_bytes.iter().position(|&b| b == 0).unwrap_or(100);
            let name = String::from_utf8_lossy(&name_bytes[..name_end]).into_owned();

            let mode = parse_octal(&header[100..108]).unwrap_or(0);
            let size = parse_octal(&header[124..136]).unwrap_or(0);
            let mtime = parse_octal(&header[136..148]).unwrap_or(0);

            // Read file data
            let mut data = vec![0u8; size as usize];
            reader.read_exact(&mut data)?;

            archive.entries.push(TarEntry {
                name,
                mode,
                size,
                mtime,
                data,
            });

            // Consume padding
            let remainder = (size as usize) % BLOCK_SIZE;
            if remainder > 0 {
                let padding = BLOCK_SIZE - remainder;
                let mut pad_buf = vec![0u8; padding];
                reader.read_exact(&mut pad_buf)?;
            }
        }

        Ok(archive)
    }

    #[must_use]
    pub fn entries(&self) -> &[TarEntry] {
        &self.entries
    }
}

impl Default for TarArchive {
    fn default() -> Self {
        Self::new()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::io::Cursor;

    #[test]
    fn test_format_octal() {
        assert_eq!(format_octal(0o644, 8), b"0000644\0");
        assert_eq!(format_octal(11, 12), b"00000000013\0");
    }

    #[test]
    fn test_parse_octal() {
        assert_eq!(parse_octal(b"0000644\0"), Some(0o644));
        assert_eq!(parse_octal(b"00000000013\0"), Some(11));
        assert_eq!(parse_octal(b"0000644 \0"), Some(0o644));
    }

    #[test]
    fn test_write_and_read_archive() {
        let mut archive = TarArchive::new();
        archive.add_file("hello.txt", b"Hello World!");
        archive.add_file("test.bin", &[1, 2, 3, 4, 5]);

        let mut buffer = Vec::new();
        archive.write_to(&mut buffer).unwrap();

        // Must be multiple of 512
        assert_eq!(buffer.len() % BLOCK_SIZE, 0);

        let mut cursor = Cursor::new(buffer);
        let read_archive = TarArchive::read_from(&mut cursor).unwrap();

        let entries = read_archive.entries();
        assert_eq!(entries.len(), 2);

        assert_eq!(entries[0].name, "hello.txt");
        assert_eq!(entries[0].data, b"Hello World!");
        assert_eq!(entries[0].size, 12);

        assert_eq!(entries[1].name, "test.bin");
        assert_eq!(entries[1].data, vec![1, 2, 3, 4, 5]);
        assert_eq!(entries[1].size, 5);
    }
}
